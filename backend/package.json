{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend for edmarket",
  "license": "ISC",
  "author": "Edward LIu",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc; npm run lint",
    "tsc": "tsc --project tsconfig.json",
    "lint": "eslint '**/*.{ts,js}'",
    "lint-fix": "eslint --fix '**/*.{ts,js}'",
    "start": "cross-env NODE_ENV=production npx tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npx tsx watch --clear-screen=false src/index.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "method-override": "^3.0.0",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.8",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "jiti": "^2.6.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0"
  }
}
